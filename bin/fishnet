#!/bin/bash
unset IFS
set -eu

if [ -z "$FISHNET_JELLYFIN_HOME" ]; then
    echo 'error: blank/missing FISHNET_JELLYFIN_HOME'
    exit 1
fi

sudo chown -R "$(whoami):jellyfin" "$FISHNET_JELLYFIN_HOME"
find "$FISHNET_JELLYFIN_HOME" -type d -exec chmod 0775 "{}" \;
find "$FISHNET_JELLYFIN_HOME" -type f -exec chmod 0664 "{}" \;
