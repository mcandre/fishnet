#!/bin/bash
unset IFS
set -eu

if [ -z "$FISHNET_JELLYFIN_HOME" ]; then
    echo 'error: blank/missing FISHNET_JELLYFIN_HOME'
    exit 1
fi

PTH="$(readlink -f "$FISHNET_JELLYFIN_HOME")"

case "$PTH" in
    '/' | "$HOME")
        echo "error: hazardous FISHNET_JELLYFIN_HOME: $FISHNET_JELLYFIN_HOME"
        exit 1
        ;;
    *)
        ;;
esac

sudo chown -R "$(whoami):jellyfin" "$PTH"
find "$PTH" -type d -exec chmod 0775 "{}" \;
find "$PTH" -type f -exec chmod 0664 "{}" \;
